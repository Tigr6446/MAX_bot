# Токен бота MAX (получить в панели разработчика MAX)
MAX_BOT_TOKEN=your_bot_token_here

# Секрет для верификации вебхуков (любая длинная случайная строка)
WEBHOOK_SECRET=change_me_to_random_string

# URL базы данных PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://maxbot:localpass@localhost:5432/max_bot

# Публичный URL, куда MAX будет слать вебхуки (для локального теста — ngrok)
PUBLIC_URL=http://localhost:8000

# Список chat_id каналов для парсинга (через запятую, числа с минусом)
PARSER_CHANNELS=-79132920662146,-71084493761167